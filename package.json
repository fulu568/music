{
  "name": "audiomaster-pro",
  "private": true,
  "version": "1.0.0",
  "description": "AudioMaster Pro - 专业高保真无损音乐播放器 (Windows 桌面客户端 & Web)",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "NODE_ENV=development electron .",
    "build:win": "vite build && electron-builder --win nsis portable --x64",
    "build:win-exe": "vite build && electron-builder --win portable --x64",
    "build:all": "vite build && electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.audiomaster.pro",
    "productName": "AudioMaster Pro",
    "copyright": "Copyright © 2026 AudioMaster Team",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png",
      "legalTrademarks": "AudioMaster Pro"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AudioMaster Pro 无损播放器",
      "uninstallDisplayName": "卸载 AudioMaster Pro"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
